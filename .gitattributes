# Text defaults first; later, more specific rules override.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.bat text eol=crlf

# Large binaries go to LFS (run `git lfs install --local` once per checkout).
*.glb  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
# Should never be committed; this rule is a tripwire.
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Engine sprite sheets and review images stay plain git: CI checks out without LFS
# (LFS pointers get read as PNGs otherwise). Move a PNG to LFS only if it is huge.

# Pokemon Essentials project data and art.
*.rxdata binary
*.dat    binary
*.png    binary
*.mid  filter=lfs diff=lfs merge=lfs -text

# Essentials files are kept byte-exact so game/.psc_base_manifest.txt hashes match in any checkout.
game/** -text
game/Plugins/PSC_*/** text eol=lf
